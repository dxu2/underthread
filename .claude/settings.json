{
  "statusLine": {"type": "command", "command": "python3 tools/statusline.py"},
  "permissions": {
    "allow": [
      "Bash(python3 stateutil.py:*)",
      "Bash(python3 tools/ensure_server.py)",
      "Bash(tail -n0 -F inbox.jsonl)",
      "Bash(ffprobe:*)",
      "Bash(ffmpeg:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {"matcher": "mcp__claude-in-chrome__.*",
       "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/onb_mark.py\" chrome", "async": true, "timeout": 20},
                 {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/live_hook.py\" post", "async": true, "timeout": 30},
                 {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/live_hook.py\" sync", "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/live_hook.py\" stop", "timeout": 10}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/live_hook.py\" stop", "timeout": 10}]}
    ]
  }
}

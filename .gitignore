# ---- secrets: never commit ----
vapid.json
push_subs.json*
*.pem
*.key
.env
.env.*

# ---- your own data and config (copy from *.example.json) ----
/config.json
/roster.json
/state.json*
/archive.json*
/inbox.jsonl*
/feeds.json*
*.lock
.*.lock
manager-handoff.md
*-handoff.md

# ---- your own layer (rules, manager notes, extensions; see docs/local.md). Updates never touch it ----
/local/

# ---- runtime folders ----
uploads/
work/
logs/
rcshots/
/.live/
/archive/
.demo/
.backups/
# avatars/ (avatars/ut/ included) is install data, like roster.json. The default Underthread patches ship in avatars/seed/ut/
# (presets/<name>/avatars/ut/ for preset roles); core/install_seed.py copies a missing one into avatars/ut/ at server start
# and after an update, and never overwrites a file that is there.
avatars/*
!avatars/seed/
# role notes of a preset (presets/<name>/roles/) copied in by tools/preset.py or core/install_seed.py: yours, not core
/roles/writer.md
/roles/director.md
/roles/ops.md
tools/models/
tools/voice/
voices*/
.claude/agent-memory/
.claude/agents/
.claude/settings.local.json
# .claude/settings.json ships with the repo (statusLine usage feed + the steward's permissions); put your own
# additions in .claude/settings.local.json, which Claude Code merges on top and git ignores.

# ---- backups: the project writes name.bak-<tag>, so match *.bak* (not just *.bak) ----
*.bak*
*~

# ---- media you generate ----
*.wav
*.mp3
*.m4a
*.mp4
*.mov

# ---- python / os ----
__pycache__/
*.pyc
.venv*/
.DS_Store

# your own private word list for tests/scan.py
tests/scan-words.txt
